# Alibaba Cloud Model Studio (DashScope) — Qwen3.8-LiveTranslate (Default)
# Get your API key from https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Region: cn-beijing (国内站北京) or ap-southeast-1 (国际站新加坡)
DASHSCOPE_REGION=cn-beijing
# Workspace ID (e.g. ws-xxxxxxxxxxxx or llm-xxxxxxxxxxxx) — required for Qwen3.8 WebRTC UDP low-latency mode
DASHSCOPE_WORKSPACE_ID=

# Google AI Studio — Gemini 3.5 Live Translate (Alternative)
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Local server bind address and port (0.0.0.0 enables Mode 2 LAN congregation listening;
# Soundbooth admin routes remain strictly localhost-only for security)
HOST=0.0.0.0
PORT=8765

# Optional Mode 2 congregation broadcast settings (can also be edited live in the web UI)
# Optional 4-digit room PIN for congregation phones (leave empty for open QR scan entry)
LISTENER_PIN=
# Optional public HTTPS URL if exposing via Cloudflare Tunnel / reverse proxy (e.g. https://sermon.example.com)
PUBLIC_BASE_URL=
